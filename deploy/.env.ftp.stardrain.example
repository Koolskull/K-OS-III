# TEMPLATE — committed. Copy to deploy/.env.ftp.stardrain (gitignored) only if
# you do not want the script to read the macOS Keychain item
# (account stardrain, server s103.etcserver.com, protocol ftp).
#
# This is the stardrain.app cPanel account. It is not deploy/.env.ftp.koolskull
# and it is not deploy/.env.ftp (DreamHost 2kool.tv).

FTP_HOST="s103.etcserver.com"
FTP_USER="stardrain"
FTP_PASSWORD=""
# The script picks the document root that already contains mialien/.
# Root index.html is replaced. Metadata folders are not uploaded into.
FTP_REMOTE_DIR=""
FTP_PROTOCOL="ftp"
FTP_PORT=""
