{
  "name": "koolskull-os-iii",
  "version": "0.2.2-beta",
  "description": "KOOLSKULL Operating System III — A web-based OS for media production.",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5555",
    "dev:koolskull": "NEXT_PUBLIC_BRAND=koolskull next dev -p 5555",
    "dev:koolskull:bun": "NEXT_PUBLIC_BRAND=koolskull bun --bun next dev -p 5555",
    "dev:koolskull:https": "NEXT_PUBLIC_BRAND=koolskull bun --bun next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem -p 5555",
    "build": "next build",
    "build:export": "NEXT_PUBLIC_BASE_PATH=/K-OS-III NEXT_PUBLIC_BRAND=kos3 ./scripts/build-static.sh",
    "build:2kooltv": "NEXT_PUBLIC_BASE_PATH= NEXT_PUBLIC_BRAND=2kooltv ./scripts/build-static.sh",
    "build:koolskull": "./scripts/build-koolskull-static.sh",
    "deploy:koolskull": "./deploy/deploy-koolskull.sh",
    "deploy:koolskull:dry": "./deploy/deploy-koolskull.sh --dry-run",
    "pack:koolskull": "./scripts/pack-koolskull-cpanel.sh",
    "start": "next start -p 5555",
    "lint": "tsc --noEmit",
    "preview:export": "npm run build:export && cd out && python3 -m http.server 4044"
  },
  "keywords": [
    "tracker",
    "midi",
    "music",
    "fm-synthesis",
    "ym2612",
    "datamoshpit"
  ],
  "author": "2kool Productions",
  "license": "ISC",
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "bcryptjs": "^3.0.3",
    "codemirror": "^6.0.2",
    "ethers": "^6.17.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "postcss": "^8.5.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "siwe": "^3.0.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.2",
    "tone": "^15.1.22",
    "typescript": "^5.9.3",
    "webamp": "^2.3.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
