# TEMPLATE — committed. Copy to deploy/.env.koolskull (gitignored) if you want
# to override public build-time values. All of these are optional for minting.
# The deploy script defaults brand + media origin if this file is empty.

NEXT_PUBLIC_BRAND="koolskull"
NEXT_PUBLIC_MEDIA_ORIGIN="https://koolskull.com"

# Optional browser RPC. Empty = publicnode / 1rpc (CORS open, no key).
NEXT_PUBLIC_ETH_RPC_URL=""

# Optional WalletConnect project id. Injected wallets (Phantom / MetaMask) work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Extra shop-admin wallets, comma-separated. koolskull.eth and dozashop.eth are already hardcoded.
NEXT_PUBLIC_SHOP_OWNER_ADDRESSES=""
