# Real credentials go in a DIFFERENT, gitignored file: deploy/.env.ftp
# (note: no ".example" at the end). That file already exists — open THAT
# one in your editor instead and fill in the values there.
#
# If you're reading this because you opened this exact file again: stop,
# close it, open deploy/.env.ftp instead.

FTP_HOST=""
FTP_USER=""
FTP_PASSWORD=""
# The directory on the server that serves 2kool.tv's document root — ask
# DreamHost/your contact there if unsure; commonly something like:
#   /home/<shell-user>/2kool.tv
FTP_REMOTE_DIR=""
