# Copy to .env.local (gitignored) and fill in for local development.
# See docs/ACCOUNTS_SPEC.md.
#
# WHAT YOU ACTUALLY NEED
# ----------------------
# koolskull.com static FTP (this is the live OS path):
#   Fill deploy/.env.ftp.koolskull with 2MHost host / user / password.
#   You do NOT need anything in this file for desktop, Scatter mint, or
#   Miyamaker Mini mint. Those talk to Scatter + a public Ethereum RPC
#   from the browser. Live Miyamaker images stay at
#   https://koolskull.com/miyamakermini/
#
# Local `bun run dev:koolskull:bun` (this Next app):
#   NEXT_PUBLIC_BRAND is enough. Media symlinks: scripts/link-koolskull-media.sh
#
# Optional (only if you want those features):
#   AUTH_SECRET + DATABASE_URL     — email/wallet accounts, K-CHAT, cloud saves
#   ALCHEMY_API_KEY                — full MY NFTS token images (server only)
#   NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID — WalletConnect; Phantom still works without it
#   GOOGLE_* / X_*                 — extra sign-in buttons
#
# Do not put FTP passwords here. koolskull.com FTP is deploy/.env.ftp.koolskull
# 2kool.tv FTP is deploy/.env.ftp (DreamHost — different server).

# Brand: kos3 | 2kooltv | koolskull
# `npm run dev:koolskull` also sets this for the local OS+discography preview.
NEXT_PUBLIC_BRAND="koolskull"
NEXT_PUBLIC_SHOP_OWNER_ADDRESS="0xF065F2a89683Dd8Cd76ab15C686a781F0b351eaB"
# Extra admin wallets, comma-separated (dozashop.eth is hardcoded with koolskull.eth).
NEXT_PUBLIC_SHOP_OWNER_ADDRESSES=""
# Leave empty to serve /mp3 and skins from this Next app (public/ symlinks).
NEXT_PUBLIC_MEDIA_ORIGIN=""

# Local dev Postgres. Production points at the project's own self-hosted
# Postgres instead.
#
# Native (Homebrew: `brew install postgresql@16`, default port 5432):
DATABASE_URL="postgresql://kos_dev:kos_dev_password@localhost:5432/kos_dev"
# Docker instead (docker-compose.dev.yml, mapped to port 5433 to avoid
# clashing with a native install): swap the port above to 5433.

# Auth.js session/JWT signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Alchemy API key — SERVER ONLY. Never NEXT_PUBLIC_. Never public_html.
# Local Node: this file (.env.local).
# 2kool.tv: Vercel env ALCHEMY_API_KEY.
# koolskull.com FTP: do not put the key in the website folder. Optional file
#   /home/<cpanel-user>/kos-secrets.php  (sibling of public_html, not inside it)
#   or omit it — minting still works; MY NFTS Mini images use koolskull.com.
ALCHEMY_API_KEY=""

# Optional dedicated Ethereum RPC for ENS (server). Defaults to Alchemy v2 URL
# when ALCHEMY_API_KEY is set, else a public RPC.
ETH_RPC_URL=""

# Optional browser-side RPC for ENS resolve in K-CHAT (wallet peer open).
NEXT_PUBLIC_ETH_RPC_URL=""

# WalletConnect / Reown project ID — public, safe to embed client-side
# (unlike ALCHEMY_API_KEY above). Get one at https://cloud.reown.com/.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Google sign-in — create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: "Web application").
# Authorized redirect URI: <your-origin>/api/auth/callback/google
# (e.g. http://localhost:5555/api/auth/callback/google for local dev).
# Leave both blank to hide the Google button entirely (auth.ts only
# registers this provider when both are set).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# X (Twitter) sign-in — create an app at https://developer.x.com/en/apps
# with OAuth 2.0 enabled. Callback URL: <your-origin>/api/auth/callback/twitter
# Leave both blank to hide the X button entirely.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
